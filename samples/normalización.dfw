{"dataflow": {"id": "dec0de00-0000-4000-8000-b18ed3de93db", "description": "", "name": "normalización", "context": {"projectId": "dec0de00-0000-4000-8000-16424278756e", "dataAppId": "dec0de00-0000-4000-8000-16424278756e", "version": 8, "usage": "DATAFLOW_PREP"}, "createdAt": "2026-09-09T16:28:15.839Z", "createdBy": "dec0de04881dfae28ed80128", "updatedAt": "2026-09-10T20:32:14.142Z", "updatedBy": "dec0de04881dfae28ed80128", "checksum": "dec0de00-0000-4000-8000-12b9d6b83f8a", "graph": {"nodes": [{"type": "target", "id": "dec0de00-0000-4000-8000-ecb2bfb6aac2", "label": "Destino de la conexión 1", "graphical": {"position": {"x": 2340, "y": 120}}, "handles": {"incoming": [{"id": "dec0de00-0000-4000-8000-80dec902128e", "type": "DEFAULT"}], "outgoing": []}, "component": {"type": "analyticsTarget", "properties": {"configuration": {"name": "Destino de la conexión 1", "settings": {"spaceName": "Entrenamiento Dataflow", "fileName": "carpeta-demo/normalizacion_telefono", "extension": "csv", "format": "txt", "connectionName": "GDDestino", "treatAsRelative": false}, "$datasourceId": "File_GoogleDriveConnector", "$state": "CONFIGURED"}}}}, {"type": "source", "id": "dec0de00-0000-4000-8000-e7214686504a", "label": "strings_sucios", "graphical": {"position": {"x": 60, "y": 120}}, "handles": {"outgoing": [{"id": "dec0de00-0000-4000-8000-9a2b89d8f663", "type": "DEFAULT"}]}, "component": {"type": "analyticsSource", "properties": {"dataEntity": {"entityId": "dec0de00-0000-4000-8000-8281d4897041"}, "configuration": {}, "type": "dataset"}}}, {"type": "processor", "id": "dec0de00-0000-4000-8000-10fedf96a5ab", "label": "Norm_nombre", "description": "", "graphical": {"position": {"x": 340, "y": 120}}, "handles": {"incoming": [{"id": "dec0de00-0000-4000-8000-c7818eaffeed", "type": "DEFAULT"}], "outgoing": [{"id": "dec0de00-0000-4000-8000-5ae9df90c3c4", "type": "DEFAULT"}]}, "component": {"type": "strings", "properties": {"configuration": {"type": "PROPERCASE", "propercaseConfiguration": {"colu