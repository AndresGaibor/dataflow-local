": "Cadenas de texto 4", "graphical": {"position": {"x": 1180, "y": 120}}, "handles": {"incoming": [{"id": "dec0de00-0000-4000-8000-fbfea17dd6b4", "type": "DEFAULT"}], "outgoing": [{"id": "dec0de00-0000-4000-8000-18cb28629bc8", "type": "DEFAULT"}]}, "component": {"type": "strings", "properties": {"configuration": {"type": "REPLACE_ON_VALUE", "replaceOnValueConfiguration": {"columnsToProcess": ["telefono_limpio"], "shouldCreateNewColumn": false, "newColumnName": "", "replaceValue": "", "replaceMethod": "REPLACE_MATCHING_WITH_VALUE", "cellValue": {"value": " ", "operator": "CONTAINS"}}, "$state": "CONFIGURED"}}}}, {"type": "processor", "id": "dec0de00-0000-4000-8000-61664499cd37", "label": "Cadenas de texto 5", "graphical": {"position": {"x": 1460, "y": 120}}, "handles": {"incoming": [{"id": "dec0de00-0000-4000-8000-2b37f4ae2b5e", "type": "DEFAULT"}], "outgoing": [{"id": "dec0de00-0000-4000-8000-8a3011ed9b47", "type": "DEFAULT"}]}, "component": {"type": "strings", "properties": {"configuration": {"type": "REPLACE_ON_VALUE", "replaceOnValueConfiguration": {"columnsToProcess": ["telefono_limpio"], "shouldCreateNewColumn": false, "newColumnName": "", "replaceValue": "", "replaceMethod": "REPLACE_MATCHING_WITH_VALUE", "cellValue": {"value": "-", "operator": "CONTAINS"}}, "$state": "CONFIGURED"}}}}, {"type": "processor", "id": "dec0de00-0000-4000-8000-466c81b2bbd6", "label": "Cadenas de texto 6", "graphical": {"position": {"x": 1740, "y": 120}}, "handles": {"incoming": [{"id": "dec0de00-0000-4000-8000-80dd03b22465", "type": "DEFAULT"}], "outgoing": [{"id": "dec0de00-0000-4000-8000-d5a269ff9e16", "type": "DEFAULT"}]}, "component": {"type": "strings", "properties": {"configuration": {"type": "REPLACE_ON_VALUE", "replaceOnValueConfiguration": {"columnsToProcess": ["telefono_limpio"], "shouldCreateNewColumn": false, "newColumnName": "", "replaceValue": "0", "replaceMethod": "REPLACE_MATCHING_WITH_VALUE", "cellValue": {"value": "593", "operator": "STARTS_WITH"}}, "$state": "CON