de00-0000-4000-8000-713381e9ab62", "type": "DEFAULT"}], "outgoing": [{"id": "dec0de00-0000-4000-8000-799762a221b4", "type": "DEFAULT"}]}, "component": {"type": "strings", "properties": {"configuration": {"type": "REPLACE_ON_VALUE", "replaceOnValueConfiguration": {"columnsToProcess": ["fecha_raw"], "shouldCreateNewColumn": false, "newColumnName": "", "replaceValue": "", "replaceMethod": "REPLACE_MATCHING_WITH_VALUE", "cellValue": {"value": " HH:mm", "operator": "CONTAINS"}}, "$state": "CONFIGURED"}}}}, {"type": "processor", "id": "dec0de00-0000-4000-8000-bab1358c355a", "label": "Eliminar_hora_min_seg", "description": "", "graphical": {"position": {"x": 680, "y": 400}}, "handles": {"incoming": [{"id": "dec0de00-0000-4000-8000-2dce981b4a9d", "type": "DEFAULT"}], "outgoing": [{"id": "dec0de00-0000-4000-8000-2aee1ad9ed0e", "type": "DEFAULT"}]}, "component": {"type": "strings", "properties": {"configuration": {"type": "REPLACE_ON_VALUE", "replaceOnValueConfiguration": {"columnsToProcess": ["fecha_raw"], "shouldCreateNewColumn": false, "newColumnName": "", "replaceValue": "", "replaceMethod": "REPLACE_MATCHING_WITH_VALUE", "cellValue": {"value": " HH:mm:ss", "operator": "CONTAINS"}}, "$state": "CONFIGURED"}}}}, {"type": "processor", "id": "dec0de00-0000-4000-8000-7b87f2e200d2", "label": "Cadenas de texto 7", "graphical": {"position": {"x": 960, "y": 400}}, "handles": {"incoming": [{"id": "dec0de00-0000-4000-8000-87081771fbf5", "type": "DEFAULT"}], "outgoing": [{"id": "dec0de00-0000-4000-8000-5b71eac168ab", "type": "DEFAULT"}]}, "component": {"type": "strings", "properties": {"configuration": {"type": "REPLACE_ON_VALUE", "replaceOnValueConfiguration": {"columnsToProcess": ["fecha_raw"], "shouldCreateNewColumn": false, "newColumnName": "", "replaceValue": "", "replaceMethod": "REPLACE_MATCHING_WITH_VALUE", "cellValue": {"value": "HH:mm:ss", "operator": "CONTAINS"}}, "$state": "CONFIGURED"}}}}, {"type": "processor", "id": "dec0de00-0000-4000-8000-e861d7c6de27", "label": "Remplazar_._por_-", "description": "", "graphical": {"position": {"x": 1520, "y": 400}}, "handles": {"incoming": [{"id": "dec0de00-0000-4000-8000-12afa339b19a", "type": "DEFAULT"}], "outgoing": [{"id": "dec0de00-0000-4000-8000-22927fadb083", "type": "DEFAULT"}]}, "component": {"type": "strings", "properties": {"configuration": {"type": "REPLACE_ON_VALUE", "replaceOnValueConfiguration": {"columnsToProcess": ["fecha_raw"], "shouldCreateNewColumn": false, "newColumnName": "", "replaceValue": "-", "replaceMethod": "REPLACE_MATCHING_WITH_VALUE", "cellValue": {"value": ".", "operator": "CONTAINS"}}, "$state": "CONFIGURED"}}}}, {"type": "processor", "id": "dec0de00-0000-4000-8000-93a621596c44", "label": "Remplazar_/_con_-", "description": "", "graphical": {"position": {"x": 1800, "y": 400}}, "handles": {"incoming": [{"id": "dec0de00-0000-4000-8000-5921f82706ef", "type": "DEFAULT"}], "outgoing": [{"id": "dec0de00-0000-4000-8000-53a8d67bf5b2", "type": "DEFAULT"}]}, "component": {"type": "strings", "properties": {"configuration": {"type": "REPLACE_ON_VALUE", "replaceOnValueConfiguration": {"columnsToProcess": ["fecha_raw"], "shouldCreateNewColumn": false, "newColumnName": "", "replaceValue": "-", "replaceMethod": "REPLACE_MATCHING_WITH_VALUE", "cellValue": {"value": "/", "operator": "CONTAINS"}}, "$state": "CONFIGURED"}}}}, {"type": "processor", "id": "dec0de00-0000-4000-8000-8b8e385ca7a1", "label": "Normalización_fechas", "description": "", "graphical": {"position": {"x": 420, "y": 640}}, "handles": {"incoming": [{"id": "dec0de00-0000-4000-8000-8cffe1ab5070", "type": "OPTIONAL"}, {"id": "dec0de00-0000-4000-8000-4a1ebfbd4e82", "type": "OPTIONAL"}, {"id": "dec0de00-0000-4000-8000-f4b4b235e783", "type": "OPTIONAL"}, {"id": "dec0de00-0000-4000-8000-ab80a6091efa", "type": "OPTIONAL"}, {"id": "dec0de00-0000-4000-8000-58c72274519b", "type": "OPTIONAL"}, {"id": "dec0de00-0000-4000-8000-467d463a615f", "type": "OPTIONAL"}, {"id": "dec0de00-0000-4000-8000-1a048d6967c0", "type": "OPTIONAL"}, {"id": "dec0de00-0000-4000-8000-fec56041b929", "type": "OPTIONAL"}, {"id": "dec0de00-0000-4000-8000-df9336a9bf59", "type": "OPTIONAL"}, {"id": "dec0de00-0000-4000-8000-67c5e29fa44b", "type": "OPTIONAL"}], "outgoing": [{"id": "dec0de00-0000-4000-8000-3c539f856d98", "type": "DEFAULT"}, {"id": "dec0de00-0000-4000-8000-ecf05002914b", "type": "OPTIONAL_1"}, {"id": "dec0de00-0000-4000-8000-0e7a5d894b73", "type": "OPTIONAL_2"}, {"id": "dec0de00-0000-4000-8000-00b186736d81", "type": "OPTIONAL_3"}, {"id": "dec0de00-0000-4000-8000-792abfeb8c78", "type": "OPTIONAL_4"}, {"id": "dec0de00-0000-4000-8000-40aa765e45e9", "type": "OPTIONAL_5"}, {"id": "dec0de00-0000-4000-8000-431557abc118", "type": "OPTIONAL_6"}, {"id": "dec0de00-0000-4000-8000-504e61d2ae95", "type": "OPTIONAL_7"}, {"id": "dec0de00-0000-4000-8000-9f18489221c5", "type": "OPTIONAL_8"}, {"id": "dec0de00-0000-4000-8000-74f7edd233b8", "type": "OPTIONAL_9"}]}, "component": {"type": "script", "properties": {"configuration": {"script": "[FechasNormalizadas]:\nNoConcatenate\n\nLOAD\n    id,\n    fecha_raw,\n    fecha_limpia,\n    formato_id,\n    formato_detectado,\n\n    If(\n        IsNull(fecha_limpia)\n        OR Len(fecha_limpia) = 0,\n\n        Null(),\n\n        If(\n            formato_id = 0,\n\n            Null(),\n\n            If(\n                Upper(fecha_roundtrip) = Upper(fecha_limpia),\n\n                Timestamp(\n                    fecha_candidata,\n                    'YYYY-MM-DD hh:mm:ss'\n                ),\n\n                Null()\n            )\n        )\n    ) as fecha,\n\n    If(\n        IsNull(fecha_limpia)\n        OR Len(fecha_limpia) = 0,\n\n        'VACIA',\n\n        If(\n            formato_id = 0,\n\n            'FORMATO_NO_RECONOCIDO',\n\n            If(\n                Upper(fecha_roundtrip) = Upper(fecha_limpia),\n\n                'VALIDA',\n\n                'FECHA_INVALIDA'\n            )\n        )\n    ) as estado_fecha\n;\n\n\nLOAD\n    *,\n\n    Pick(\n        formato_id,\n\n        Date(fecha_candidata, 'YYYY-MM-DD'),\n        Date(fecha_candidata, 'DD/MM/YYYY'),\n        Date(fecha_candidata, 'DD-MM-YYYY'),\n        Date(fecha_candidata, 'YYYY/MM/DD'),\n        Date(fecha_candidata, 'DD-MMM-YYYY'),\n        Date(fecha_candidata, 'DD.MM.YYYY'),\n\n        Timestamp(\n            fecha_candidata,\n            'YYYY-MM-DD hh:mm:ss'\n        ),\n\n        Timestamp(\n            fecha_candidata,\n            'DD/MM/YYYY hh:mm'\n        ),\n\n        Timestamp(\n            fecha_candidata,\n            'YYYY-MM-DDThh:mm:ss'\n        )\n    ) as fecha_roundtrip\n;\n\n\nLOAD\n    *,\n\n    Pick(\n        formato_id,\n\n        Date#(fecha_limpia, 'YYYY-MM-DD'),\n        Date#(fecha_limpia, 'DD/MM/YYYY'),\n        Date#(fecha_limpia, 'DD-MM-YYYY'),\n        Date#(fecha_limpia, 'YYYY/MM/DD'),\n        Date#(fecha_limpia, 'DD-MMM-YYYY'),\n        Date#(fecha_limpia, 'DD.MM.YYYY'),\n\n        Timestamp#(\n            fecha_limpia,\n            'YYYY-MM-DD hh:mm:ss'\n        ),\n\n        Timestamp#(\n            fecha_limpia,\n            'DD/MM/YYYY hh:mm'\n        ),\n\n        Timestamp#(\n            fecha_limpia,\n            'YYYY-MM-DDThh:mm:ss'\n        )\n    ) as fecha_candidata,\n\n    Pick(\n        formato_id,\n        'YYYY-MM-DD',\n        'DD/MM/YYYY',\n        'DD-MM-YYYY',\n        'YYYY/MM/DD',\n        'DD-MMM-YYYY',\n        'DD.MM.YYYY',\n        'YYYY-MM-DD HH:mm:ss',\n        'DD/MM/YYYY HH:mm',\n        'ISO YYYY-MM-DDTHH:mm:ss'\n    ) as formato_detectado\n;\n\n\nLOAD\n    id,\n    fecha_raw,\n    Trim(fecha_raw) as fecha_limpia,\n\n    MatchRegExI(\n        Trim(fecha_raw),\n\n        '[0-9]{4}-[0-9]{2}-[0-9]{2}',\n        '[0-9]{2}/[0-9]{2}/[0-9]{4}',\n        '[0-9]{2}-[0-9]{2}-[0-9]{4}',\n        '[0-9]{4}/[0-9]{2}/[0-9]{2}',\n        '[0-9]{2}-[A-Za-z]{3}-[0-9]{4}',\n        '[0-9]{2}[.][0-9]{2}[.][0-9]{4}',\n        '[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}',\n        '[0-9]{2}/[0-9]{2}/[0-9]{4} [0-9]{2}:[0-9]{2}',\n        '[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}'\n    ) as formato_id\n\nResident [fechas_sucias];\n\nDROP TABLE [fechas_sucias];", "schemaEntityId": "dec0de80271f4826e3203661", "$state": "CONFIGURED"}}}}, {"type": "processor", "id": "dec0de00-0000-4000-8000-94af0d91b3a1", "label": "Filtro 4", "graphical": {"position": {"x": 720, "y": 640}}, "handles": {"incoming": [{"id": "dec0de00-0000-4000-8000-0d275d79665c", "type": "DEFAULT"}], "outgoing": [{"id": "dec0de00-0000-4000-8000-9a7a1d12c4b6", "type": "DEFAULT"}, {"id": "dec0de00-0000-4000-8000-eff90b784b11", "type": "REJECT"}]}, "component": {"type": "filter", "properties": {"configuration": {"logicalOpType": "ALL", "filters": [{"columnName": "estado_fecha", "function": "EMPTY", "operator": "EQUAL", "compareWith": "VALUE", "value": "VALIDA", "columnToCompareWith": ""}], "$state": "CONFIGURED"}}}}, {"type": "processor", "id": "dec0de00-0000-4000-8000-6b49bfc553fe", "label": "Validos", "description": "", "graphical": {"position": {"x": 980, "y": 620}}, "handles": {"incoming": [{"id": "dec0de00-0000-4000-8000-f2cbbfbeb2d2", "type": "DEFAULT"}], "outgoing": [{"id": "dec0de00-0000-4000-8000-1db7d79ae119", "type": "DEFAULT"}]}, "component": {"type": "strings", "properties": {"configuration": {"type": "REPLACE_ON_VALUE", "replaceOnValueConfiguration": {"columnsToProcess": ["id"], "shouldCreateNewColumn": false, "newColumnName": "", "replaceValue": "", "replaceMethod": "REPLACE_CELL_WITH_VALUE", "cellValue": {"value": " ", "operator": "EQUALS"}}, "$state": "CONFIGURED"}}}}, {"type": "processor", "id": "dec0de00-0000-4000-8000-9f94d4d83ded", "label": "Rechazados", "description": "", "graphical": {"position": {"x": 980, "y": 720}}, "handles": {"incoming": [{"id": "dec0de00-0000-4000-8000-545437b1078f", "type": "DEFAULT"}], "outgoing": [{"id": "dec0de00-0000-4000-8000-4c9c09300cf0", "type": "DEFAULT"}]}, "component": {"type": "strings", "properties": {"configuration": {"type": "REPLACE_ON_VALUE", "replaceOnValueConfiguration": {"columnsToProcess": ["id"], "shouldCreateNewColumn": false, "newColumnName": "", "replaceValue": "", "replaceMethod": "REPLACE_CELL_WITH_VALUE", "cellValue": {"value": " ", "operator": "EQUALS"}}, "$state": "CONFIGURED"}}}}, {"type": "source", "id": "dec0de00-0000-4000-8000-bdd10094cab8", "label": "numeros_sucios", "graphical": {"position": {"x": 100, "y": 840}}, "handles": {"outgoing": [{"id": "dec0de00-0000-4000-8000-89eec6207be1", "type": "DEFAULT"}]}, "component": {"type": "analyticsSource", "properties": {"dataEntity": {"entityId": "dec0de00-0000-4000-8000-41935533285d"}, "configuration": {}, "type": "dataset"}}}, {"type": "processor", "id": "dec0de00-0000-4000-8000-c40e9e59001d", "label": "Números 1", "graphical": {"position": {"x": 640, "y": 860}}, "handles": {"incoming": [{"id": "dec0de00-0000-4000-8000-ee7d9ac0ef39", "type": "DEFAULT"}], "outgoing": [{"id": "dec0de00-0000-4000-8000-6277cc633fbd", "type": "DEFAULT"}]}, "component": {"type": "numbers", "properties": {"configuration": {"type": "CONVERT_TO_NUMBER", "convertToNumberConfiguration": {"shouldCreateNewColumn": true, "columnsToProcess": ["numero_raw"], "newColumnName": "numero", "decimalSeparator": ",", "thousandSeparator": "."}, "$state": "CONFIGURED"}}}}, {"type": "source", "id": "dec0de00-0000-4000-8000-3d1e3aadee0b", "label": "numeros_sucios 1", "graphical": {"position": {"x": 100, "y": 1160}}, "handles": {"outgoing": [{"id": "dec0de00-0000-4000-8000-7745925d95d1", "type": "DEFAULT"}]}, "component": {"type": "analyticsSource", "properties": {"dataEntity": {"entityId": "dec0de00-0000-4000-8000-0c444b5805fd"}, "configuration": {}, "type": "dataset"}}}, {"type": "processor", "id": "dec0de00-0000-4000-8000-6b50506045c6", "label": "Script de Qlik 1", "graphical": {"position": {"x": 380, "y": 860}}, "handles": {"incoming": [{"id": "dec0de00-0000-4000-8000-5d34874b6b25", "type": "OPTIONAL"}, {"id": "dec0de00-0000-4000-8000-ef322760e53e", "type": "OPTIONAL"}, {"id": "dec0de00-0000-4000-8000-7ad451e1b821", "type": "OPTIONAL"}, {"id": "dec0de00-0000-4000-8000-f33bdb2fecb9", "type": "OPTIONAL"}, {"id": "dec0de00-0000-4000-8000-0b9d54729810", "type": "OPTIONAL"}, {"id": "dec0de00-0000-4000-8000-b1a0889d6ede", "type": "OPTIONAL"}, {"id": "dec0de00-0000-4000-8000-9598aa1ce44a", "type": "OPTIONAL"}, {"id": "dec0de00-0000-4000-8000-131d1d11d4f2", "type": "OPTIONAL"}, {"id": "dec0de00-0000-4000-8000-94334df4e7ec", "type": "OPTIONAL"}, {"id": "dec0de00-0000-4000-8000-6d29f89ccf83", "type": "OPTIONAL"}], "outgoing": [{"id": "dec0de00-0000-4000-8000-04f846e9081f", "type": "DEFAULT"}, {"id": "dec0de00-0000-4000-8000-9c03d1663e28", "type": "OPTIONAL_1"}, {"id": "dec0de00-0000-4000-8000-018e857a43d8", "type": "OPTIONAL_2"}, {"id": "dec0de00-0000-4000-8000-ed01ae2524f8", "type": "OPTIONAL_3"}, {"id": "dec0de00-0000-4000-8000-e3482fea7e2e", "type": "OPTIONAL_4"}, {"id": "dec0de00-0000-4000-8000-4a0466477fdd", "type": "OPTIONAL_5"}, {"id": "dec0de00-0000-4000-8000-cd0ee8281d0a", "type": "OPTIONAL_6"}, {"id": "dec0de00-0000-4000-8000-64b5375759cf", "type": "OPTIONAL_7"}, {"id": "dec0de00-0000-4000-8000-c988de11f278", "type": "OPTIONAL_8"}, {"id": "dec0de00-0000-4000-8000-c46aec61d750", "type": "OPTIONAL_9"}]}, "component": {"type": "script", "properties": {"configuration": {"script": "[NumerosNormalizados]:\nNoConcatenate\n\nLOAD\n    id,\n    numero_raw,\n    numero_limpio,\n    formato_numero,\n\n    If(\n        IsNull(numero_limpio) OR Len(numero_limpio) = 0,\n        Null(),\n\n        Pick(\n            formato_id,\n\n            // 1: 1200.50\n            Num#(\n                numero_limpio,\n                '##############0.############',\n                '.',\n                ','\n            ),\n\n            // 2: 1.200,50\n            Num#(\n                numero_limpio,\n                '#.##0,############',\n                ',',\n                '.'\n            ),\n\n            // 3: 1,200.50\n            Num#(\n                numero_limpio,\n                '#,##0.############',\n                '.',\n                ','\n            ),\n\n            // 4: 1200,50\n            Num#(\n                numero_limpio,\n                '##############0,############',\n                ',',\n                '.'\n            ),\n\n            // 5: entero, por ejemplo 150\n            Num#(\n                numero_limpio,\n                '##############0'\n            )\n        )\n    ) as numero,\n\n    If(\n        IsNull(numero_limpio) OR Len(numero_limpio) = 0,\n        'VACIO',\n\n        If(\n            formato_id = 0,\n            'FORMATO_NO_RECONOCIDO',\n            'VALIDO'\n        )\n    ) as estado_numero\n;\n\n\n// =====================================================\n// DETECTAR EL FORMATO\n// =====================================================\nLOAD\n    id,\n    numero_raw,\n    Trim(numero_raw) as numero_limpio,\n\n    MatchRegExI(\n        Trim(numero_raw),\n\n        // 1: decimal con punto\n        '[+-]?[0-9]+\\.[0-9]+',\n\n        // 2: miles con punto + decimal con coma\n        '[+-]?[0-9]{1,3}(\\.[0-9]{3})+,[0-9]+',\n\n        // 3: miles con coma + decimal con punto\n        '[+-]?[0-9]{1,3}(,[0-9]{3})+\\.[0-9]+',\n\n        // 4: decimal con coma, sin miles\n        '[+-]?[0-9]+,[0-9]+',\n\n        // 5: entero\n        '[+-]?[0-9]+'\n\n    ) as formato_id,\n\n    Pick(\n        MatchRegExI(\n            Trim(numero_raw),\n\n            '[+-]?[0-9]+\\.[0-9]+',\n            '[+-]?[0-9]{1,3}(\\.[0-9]{3})+,[0-9]+',\n            '[+-]?[0-9]{1,3}(,[0-9]{3})+\\.[0-9]+',\n            '[+-]?[0-9]+,[0-9]+',\n            '[+-]?[0-9]+'\n        ),\n\n        'DECIMAL_PUNTO',\n        'MILES_PUNTO_DECIMAL_COMA',\n        'MILES_COMA_DECIMAL_PUNTO',\n        'DECIMAL_COMA',\n        'ENTERO'\n\n    ) as formato_numero\n\nResident [numeros_sucios];\n\nDROP TABLE [numeros_sucios];", "schemaEntityId": "dec0de3b3c9532380b3aa6ca", "$state": "CONFIGURED"}}}}, {"type": "processor", 