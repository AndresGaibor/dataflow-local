///$tab Main

SET ThousandSep=',';

SET DecimalSep='.';

SET MoneyThousandSep=',';

SET MoneyDecimalSep='.';

SET MoneyFormat='$#,##0.00;-$#,##0.00';

SET TimeFormat='h:mm:ss TT';

SET DateFormat='M/D/YYYY';

SET TimestampFormat='M/D/YYYY h:mm:ss[.fff] TT';

SET FirstWeekDay=6;

SET BrokenWeeks=1;

SET ReferenceDay=0;

SET FirstMonthOfYear=1;

SET CollationLocale='en-US';

SET MonthNames='Jan;Feb;Mar;Apr;May;Jun;Jul;Aug;Sep;Oct;Nov;Dec';

SET LongMonthNames='January;February;March;April;May;June;July;August;September;October;November;December';

SET DayNames='Mon;Tue;Wed;Thu;Fri;Sat;Sun';

SET LongDayNames='Monday;Tuesday;Wednesday;Thursday;Friday;Saturday;Sunday';

SET NumericalAbbreviation='3:k;6:M;9:G;12:T;15:P;18:E;21:Z;24:Y;-3:m;-6:μ;-9:n;-12:p;-15:f;-18:a;-21:z;-24:y';



///$tab Generated

[clientes]:

NOCONCATENATE

LOAD

	[cliente_id],

	[cedula],

	[nombre],

	[apellido],

	[fecha_nacimiento],

	[ciudad],

	[provincia],

	[region],

	[email],

	[telefono],

	[segmento],

	[fecha_registro]

FROM [lib://Entrenamiento Dataflow:DataFiles/clientes.csv] (txt, utf8, embedded labels, delimiter is ',', msq);



// [Fork_DEFAULT]

[Auto-join]:

NOCONCATENATE

LOAD

	[cliente_id],

	[cedula],

	[nombre],

	[apellido],

	[fecha_nacimiento],

	[ciudad],

	[provincia],

	[region],

	[email],

	[telefono],

	[segmento],

	[fecha_registro]

RESIDENT [clientes];



LEFT JOIN([Auto-join])

	// [Ciudad de referencia], [Fork_OPTIONAL_1]

	LOAD

		[cliente_id],

		[ciudad] AS [ciudad_ref]

	RESIDENT [clientes];



[Por segmento]:

NOCONCATENATE

LOAD

	[segmento],

	Count([cliente_id]) AS [n],

	Sum([cedula]) AS [suma_ced],

	Avg([cedula]) AS [media_ced]

RESIDENT [Auto-join]

GROUP BY [segmento];

DROP TABLE [Auto-join];



STORE [Por segmento] INTO [lib://Entrenamiento Dataflow:GDDestino/emu_join_agg.csv] (txt);



DROP TABLE [Por segmento];



DROP TABLE [clientes];


